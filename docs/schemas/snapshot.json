{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis://schemas/snapshot",
  "title": "WorkforceSnapshot",
  "description": "队列快照模型。对应 workforce.py:WorkforceRegistry.snapshot()。",
  "type": "object",
  "properties": {
    "counts": {
      "type": "object",
      "description": "各状态的任务计数"
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "task.json" }
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "event-record.json" }
    },
    "workers": {
      "type": "array",
      "items": { "$ref": "worker-info.json" }
    },
    "lease_seconds": {
      "type": "integer"
    }
  }
}
