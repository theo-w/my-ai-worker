{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis://schemas/worker-info",
  "title": "WorkerInfo",
  "description": "员工信息模型。对应 workforce.py:WorkforceRegistry.heartbeat_worker() 和 snapshot()。",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "员工标识，从 token 派生，不可请求体指定"
    },
    "status": {
      "type": "string",
      "enum": ["idle", "working", "waiting_tool", "blocked"],
      "description": "员工运行时状态"
    },
    "current_task_id": {
      "type": ["string", "null"],
      "description": "当前执行的任务 ID"
    },
    "progress": {
      "type": "string",
      "maxLength": 500,
      "description": "进度描述（0-100 估计值，不视为完成证明）"
    },
    "last_error": {
      "type": "string",
      "maxLength": 1000,
      "description": "最后一次错误信息"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time",
      "description": "最后一次心跳时间"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "员工能力列表，服务端分配，员工不可自赋"
    }
  }
}
